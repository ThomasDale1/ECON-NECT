{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "solver",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/solver",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}

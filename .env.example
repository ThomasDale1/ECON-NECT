# ─────────────────────────────────────────────────────────────────────────────
# ECON NECT — plantilla de variables de entorno
#
# Este archivo SÍ se versiona. Solo lleva placeholders.
# Los valores reales viven en .env.local, que está en .gitignore y nunca se sube.
#
# TODAS son variables de servidor. NINGUNA lleva prefijo NEXT_PUBLIC_.
# Una credencial con prefijo público termina en el bundle del navegador, visible
# para cualquiera que abra las herramientas de desarrollo. Eso rompe AGENTS.md §1.4.
# ─────────────────────────────────────────────────────────────────────────────

# --- Prisma (Nexus ECON) -----------------------------------------------------
# Aplicación Next.js. Login por POST /api/auth/login, que fija una cookie de
# sesión Secure/HttpOnly/SameSite=strict. Hay que guardar esa cookie y reenviarla
# en cada llamada siguiente.
PRISMA_BASE_URL=https://host-del-sandbox-de-prisma
PRISMA_EMAIL=
PRISMA_PASSWORD=

# --- Startrack ---------------------------------------------------------------
# Aplicación PHP. El login (POST /login.php) pide TRES datos, no dos:
# número de cliente, usuario y clave. La API REST bajo /api/ acepta además
# autenticación básica (WWW-Authenticate: Basic realm="API").
STARTRACK_BASE_URL=https://host-del-sandbox-de-startrack
STARTRACK_CLIENT=
STARTRACK_USER=
STARTRACK_PASSWORD=

# --- Claves de acceso por rol (D.5) ------------------------------------------
# Una clave por rol, no una compartida. Varios jueces pueden entrar a la vez y
# cada uno cae en la vista pensada para su trabajo real. Generar cadenas largas
# y distintas entre sí; no reutilizar la misma en dos roles.
NECT_CLAVE_PROYECTOS=
NECT_CLAVE_LOGISTICA=
NECT_CLAVE_MANTENIMIENTO=
NECT_CLAVE_COSTOS=
NECT_CLAVE_DIRECCION=

# --- Límite de escritura (S-A4) ----------------------------------------------
# El servidor solo acepta propagar cambios sobre estos recursos. Es una
# restricción de servidor con prueba que la verifica, no un botón escondido.
# El sandbox es compartido con otros 12 equipos: escribir sobre un recurso ajeno
# les rompe la demo a ellos y nos descalifica a nosotros.
NECT_EQUIPO_PROPIO=
NECT_PROYECTO_PROPIO=

# --- Copiloto de consulta (opcional, solo si se construye S-A6) --------------
OPENAI_API_KEY=

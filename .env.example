# ─────────────────────────────────────────────────────────────────────────────
# ECON NECT — plantilla de variables de entorno
#
# Este archivo SÍ se versiona. Solo lleva placeholders.
# Los valores reales viven en .env.local, que está en .gitignore y nunca se sube.
#
# TODAS son variables de servidor. NINGUNA lleva prefijo NEXT_PUBLIC_.
# Una credencial con prefijo público termina en el bundle del navegador, visible
# para cualquiera que abra las herramientas de desarrollo. Eso rompe AGENTS.md §1.4.
# ─────────────────────────────────────────────────────────────────────────────

# --- Prisma (Nexus ECON) -----------------------------------------------------
# Aplicación Next.js. Login por POST /api/auth/login, que fija una cookie de
# sesión Secure/HttpOnly/SameSite=strict. Hay que guardar esa cookie y reenviarla
# en cada llamada siguiente.
PRISMA_BASE_URL=https://host-del-sandbox-de-prisma
PRISMA_EMAIL=
PRISMA_PASSWORD=

# --- Startrack ---------------------------------------------------------------
# Aplicación PHP. El login (POST /login.php) pide TRES datos, no dos:
# número de cliente, usuario y clave. La API REST bajo /api/ acepta además
# autenticación básica (WWW-Authenticate: Basic realm="API").
STARTRACK_BASE_URL=https://host-del-sandbox-de-startrack
STARTRACK_CLIENT=
STARTRACK_USER=
STARTRACK_PASSWORD=

# --- Claves de acceso por rol (D.5) ------------------------------------------
# Una clave por rol, no una compartida. Varios jueces pueden entrar a la vez y
# cada uno cae en la vista pensada para su trabajo real. Generar cadenas largas
# y distintas entre sí; no reutilizar la misma en dos roles.
NECT_CLAVE_PROYECTOS=
NECT_CLAVE_LOGISTICA=
NECT_CLAVE_MANTENIMIENTO=
NECT_CLAVE_COSTOS=
NECT_CLAVE_DIRECCION=

# Clave de admin superusuario: ve todo, para manejar la demo. No es una gerencia
# de ECON, es nuestra llave — por eso no entra al vocabulario de roles del
# contrato (lib/tipos/canonico.ts) ni cambia la matriz de responsabilidades. Aun con esta clave, la
# propagación sigue limitada a los recursos propios de abajo: la restricción es
# de servidor y no la levanta ningún rol.
NECT_CLAVE_ADMIN=

# --- Límite de escritura (S-A4) ----------------------------------------------
# El servidor solo acepta propagar cambios sobre estos recursos. Es una
# restricción de servidor con prueba que la verifica, no un botón escondido.
# El sandbox es compartido con otros 12 equipos: escribir sobre un recurso ajeno
# les rompe la demo a ellos y nos descalifica a nosotros.
#
# Formato: lista separada por comas. Cada valor se compara exacto (ignorando
# espacios y mayúsculas) contra el código de activo, el id del equipo en Prisma
# o el id del vehículo en Startrack; y contra el código PROY-### o el id de
# proyecto. Si cualquiera de las dos está vacía, el servidor rechaza TODA
# escritura — falla cerrada, a propósito.
NECT_EQUIPO_PROPIO=
NECT_PROYECTO_PROPIO=

# Pruebas vivas con escritura real (S-A11 P4/P3). Debe quedar vacia por defecto.
# Solo poner "1" de forma local cuando el equipo decida probar contra su recurso
# propio y pueda dejar el sandbox de vuelta en estado operativo.
NECT_PRUEBAS_ESCRITURA=

# --- Servicio local de inteligencia (S-A6+) ---------------------------------
# Un solo FastAPI para O.D.I.N., riesgo y optimización. Qwen corre localmente
# mediante Ollama; no se configura ninguna clave de un LLM de nube.
INTELLIGENCE_BASE_URL=http://127.0.0.1:8001
ODIN_MODEL_BASE_URL=http://127.0.0.1:11434
ODIN_MODEL_NAME=qwen3:4b-instruct
ODIN_MODEL_TIMEOUT_SECONDS=20

# --- Optimizador de planeación (opcional, solo si se construye S-A7) --------
# URL del microservicio Python de services/solver/ (FastAPI + OR-Tools).
# Variable de servidor: lib/optimizador/cliente.ts es el único que la lee.
SOLVER_BASE_URL=http://127.0.0.1:8000
